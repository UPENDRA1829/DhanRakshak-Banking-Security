        if(lipSyncResult==='FAIL') s+=20;
        if(speechMatchResult==='FAIL') s+=20;
        updateRiskUI(Math.min(s,100));
    },500);
}
startLiveRiskUpdater();

/* ═══════════════════════════════════════════════
   ENROLMENT FLOW (NEW)
═══════════════════════════════════════════════ */
let enrollStream=null;
let enrollActive=false;
let capturedEmbeddings=[];
const CAPTURE_TOTAL=5;

async function startEnrolment(event) {
    if(enrollActive) return;
    const userId=document.getElementById('enrollUserId').value.trim();
    if(!userId){ alert('Please enter a User ID.'); return; }
    if(!faceApiReady){ alert('face-api.js models are still loading. Please wait a moment.'); return; }

    enrollActive=true;
    addRipple(event.currentTarget,event);
    document.getElementById('enrollBtn').disabled=true;
    document.getElementById('enrollResetBtn').disabled=false;
    capturedEmbeddings=[];

    try {
        // Step 1 → active
        setEnrolStep(1,'active');

        // Start camera
        setEnrolProcessing(true,'STARTING CAMERA...');
        enrollStream=await navigator.mediaDevices.getUserMedia({video:{width:{ideal:640},height:{ideal:480},facingMode:'user'},audio:false});
        const video=document.getElementById('enrollVideoEl');
        video.srcObject=enrollStream;
        video.setAttribute('playsinline',''); video.setAttribute('muted',''); video.setAttribute('autoplay','');
        try{await video.play();}catch(e){video.muted=true;await video.play();}
        await new Promise(r=>{ if(video.videoWidth>0) return r(); video.addEventListener('loadedmetadata',r,{once:true}); setTimeout(r,2000); });
        document.getElementById('enrollPlaceholder').style.display='none';
        document.getElementById('enrollLiveBadge').classList.add('show');
        document.getElementById('enrollScanLine').classList.add('active');
        setEnrolStep(1,'done'); setEnrolStep(2,'active');

        // Step 2: Capture 5 frames
        setEnrolProcessing(true,'CAPTURING FACE FRAMES — look at camera');
        for(let i=0;i<CAPTURE_TOTAL;i++){
            await delay(1200); // gap between captures
            const detection=await faceapi
                .detectSingleFace(video,new faceapi.TinyFaceDetectorOptions())
                .withFaceLandmarks()
                .withFaceDescriptor();
            if(!detection){
                i--; // retry this frame
                setEnrolProcessing(true,`Frame ${i+1}/${CAPTURE_TOTAL} — no face, align face and wait...`);
                await delay(800);
                continue;
            }
            capturedEmbeddings.push(Array.from(detection.descriptor));
            const pct=Math.round(((i+1)/CAPTURE_TOTAL)*100);
            document.getElementById('captureFill').style.width=pct+'%';
            document.getElementById('captureCount').textContent=`${i+1} / ${CAPTURE_TOTAL} frames`;
            setEnrolProcessing(true,`Captured frame ${i+1}/${CAPTURE_TOTAL}`);
        }
        setEnrolStep(2,'done'); setEnrolStep(3,'active');

        // Step 3: Average embeddings
        setEnrolProcessing(true,'COMPUTING AVERAGE EMBEDDING...');
        await delay(500);
        const avgEmb=averageEmbeddings(capturedEmbeddings);
        setEnrolStep(3,'done'); setEnrolStep(4,'active');

        // Step 4: Send to backend
        setEnrolProcessing(true,'SENDING TO BACKEND...');
        const res=await fetch(`${BACKEND_URL}/api/enrol`,{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({userId,embedding:avgEmb})
        });
        if(!res.ok){
            const err=await res.json().catch(()=>({detail:'Server error'}));
            throw new Error(err.detail||'Enrolment failed');
        }
        const data=await res.json();
        setEnrolStep(4,'done'); setEnrolStep(5,'done');
        document.getElementById('enrollResultText').textContent=`✓ ${data.message||'Enrolment successful!'} You can now log in.`;
        setEnrolProcessing(false);

    } catch(err) {
        console.error('Enrolment error:',err);
        setEnrolProcessing(false);
        // Mark current step as error
        for(let i=1;i<=5;i++){
            const el=document.getElementById('eStep'+i);
            if(el.classList.contains('active')){ el.classList.remove('active'); el.classList.add('error'); break; }
        }
        document.getElementById('enrollResultText').textContent='Error: '+err.message;
        setEnrolStep(5,'error');
        document.getElementById('enrollBtn').disabled=false;
    }
}

function averageEmbeddings(embs) {
    const len=embs[0].length;
    const avg=new Array(len).fill(0);
    for(const e of embs){ for(let i=0;i<len;i++) avg[i]+=e[i]; }
    for(let i=0;i<len;i++) avg[i]/=embs.length;
    return avg;
}

function setEnrolStep(n,state) {
    const el=document.getElementById('eStep'+n);
    el.className='enrol-step '+state;
}
function setEnrolProcessing(show,text='') {
    const row=document.getElementById('enrollProcessingRow');
    document.getElementById('enrollProcessingText').textContent=text;
    show?row.classList.add('show'):row.classList.remove('show');
}
function resetEnrolment(event) {
    addRipple(event.currentTarget,event);
    if(enrollStream){ enrollStream.getTracks().forEach(t=>t.stop()); enrollStream=null; }
    enrollActive=false; capturedEmbeddings=[];
    document.getElementById('enrollVideoEl').srcObject=null;
    document.getElementById('enrollPlaceholder').style.display='flex';
    document.getElementById('enrollLiveBadge').classList.remove('show');
    document.getElementById('enrollScanLine').classList.remove('active');
    document.getElementById('captureFill').style.width='0%';
    document.getElementById('captureCount').textContent='0 / 5 frames';
    document.getElementById('enrollResultText').textContent='User will be ready to log in.';
    for(let i=1;i<=5;i++){
        const el=document.getElementById('eStep'+i);
        el.className='enrol-step'+(i===1?' active':'');
    }
    setEnrolProcessing(false);
    document.getElementById('enrollBtn').disabled=false;
    document.getElementById('enrollResetBtn').disabled=true;
}
</script>

<!-- THREE.JS 3D BACKGROUND — unchanged from original -->
<script>
(()=>{
    const canvas=document.getElementById('bgCanvas');
    const renderer=new THREE.WebGLRenderer({canvas,alpha:true,antialias:false});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio,1.5));
    renderer.setSize(window.innerWidth,window.innerHeight);
    const scene=new THREE.Scene();
    const camera=new THREE.PerspectiveCamera(60,window.innerWidth/window.innerHeight,0.1,200);
    camera.position.set(0,7,22);

    // Lights
    scene.add(new THREE.AmbientLight(0x112244,2));
    const keyLight=new THREE.PointLight(0x00d4ff,3,40);
    keyLight.position.set(0,8,0); scene.add(keyLight);
    const rimLight=new THREE.PointLight(0x00ff9f,1.5,30);
    rimLight.position.set(-10,5,-8); scene.add(rimLight);

    // Floor grid
    const gridHelper=new THREE.GridHelper(60,30,0x001a2e,0x001a2e);
    scene.add(gridHelper);

    // Vault
    function makeVault(){
        const g=new THREE.Group();
        const body=new THREE.Mesh(new THREE.CylinderGeometry(2.5,2.5,3,32),new THREE.MeshStandardMaterial({color:0x0a1628,metalness:0.9,roughness:0.2}));
        body.position.y=1.5; g.add(body);
        const door=new THREE.Mesh(new THREE.CylinderGeometry(2.4,2.4,0.4,32),new THREE.MeshStandardMaterial({color:0x0d2040,metalness:0.95,roughness:0.1}));
        door.position.y=2; g.add(door);
        const wheel=new THREE.Mesh(new THREE.TorusGeometry(1.2,0.12,8,24),new THREE.MeshStandardMaterial({color:0x00d4ff,metalness:0.8,roughness:0.2,emissive:0x003344,emissiveIntensity:0.5}));
        wheel.rotation.x=Math.PI/2; wheel.position.y=2.22; wheel.name='wheel'; g.add(wheel);
        const spoke1=new THREE.Mesh(new THREE.BoxGeometry(2.4,0.1,0.1),new THREE.MeshStandardMaterial({color:0x00d4ff,metalness:0.8}));
        spoke1.position.y=2.22; g.add(spoke1);
        const spoke2=new THREE.Mesh(new THREE.BoxGeometry(0.1,0.1,2.4),new THREE.MeshStandardMaterial({color:0x00d4ff,metalness:0.8}));
        spoke2.position.y=2.22; g.add(spoke2);
        const beacon=new THREE.Mesh(new THREE.SphereGeometry(0.18,8,8),new THREE.MeshStandardMaterial({color:0xff3366,emissive:0xff3366,emissiveIntensity:1}));
        beacon.position.set(0,3.3,0); beacon.name='beacon'; g.add(beacon);
        return g;
    }
    const vault=makeVault(); scene.add(vault);

    // Shield
    const SHIELD_R=5;
    const shieldOuterMat=new THREE.MeshStandardMaterial({color:0x00d4ff,transparent:true,opacity:0.18,wireframe:true,side:THREE.DoubleSide});
    const shieldInnerMat=new THREE.MeshStandardMaterial({color:0x00d4ff,transparent:true,opacity:0.04,side:THREE.DoubleSide});
    const shieldOuter=new THREE.Mesh(new THREE.IcosahedronGeometry(SHIELD_R,2),shieldOuterMat);
    const shieldInner=new THREE.Mesh(new THREE.IcosahedronGeometry(SHIELD_R*0.85,1),shieldInnerMat);
    scene.add(shieldOuter); scene.add(shieldInner);

    // Rings
    const rings=[];
    for(let i=0;i<3;i++){
        const r=new THREE.Mesh(new THREE.TorusGeometry(SHIELD_R+(i*0.3),0.04,4,80),new THREE.MeshStandardMaterial({color:0x00d4ff,emissive:0x002233,emissiveIntensity:0.3,transparent:true,opacity:0.5-i*0.1}));
        scene.add(r); rings.push(r);
    }

    // Gangsters
    function makeGangster(color){
        const g=new THREE.Group();
        const body=new THREE.Mesh(new THREE.BoxGeometry(0.7,1.1,0.4),new THREE.MeshStandardMaterial({color,metalness:0.3,roughness:0.8}));
        body.position.y=0.9; g.add(body);
        const head=new THREE.Mesh(new THREE.BoxGeometry(0.5,0.5,0.45),new THREE.MeshStandardMaterial({color:0x1a1a1a}));
        head.position.y=1.75; g.add(head);
        const larm=new THREE.Mesh(new THREE.BoxGeometry(0.22,0.8,0.22),new THREE.MeshStandardMaterial({color,metalness:0.2}));
        larm.position.set(-0.46,0.85,0); g.add(larm);
        const rarm=new THREE.Mesh(new THREE.BoxGeometry(0.22,0.8,0.22),new THREE.MeshStandardMaterial({color,metalness:0.2}));
        rarm.position.set(0.46,0.85,0); g.add(rarm);
        const lleg=new THREE.Mesh(new THREE.BoxGeometry(0.28,0.75,0.28),new THREE.MeshStandardMaterial({color:0x0a0a14}));
        lleg.position.set(-0.2,0.13,0); g.add(lleg);
        const rleg=new THREE.Mesh(new THREE.BoxGeometry(0.28,0.75,0.28),new THREE.MeshStandardMaterial({color:0x0a0a14}));
        rleg.position.set(0.2,0.13,0); g.add(rleg);
        return g;
    }
    const GANGSTER_CONFIGS=[
        {angle:0.25,startDist:16,speed:0.016,color:0x1a1a2e},
        {angle:Math.PI-0.25,startDist:16,speed:0.013,color:0x0d0d1a},
        {angle:Math.PI*0.55,startDist:17,speed:0.011,color:0x1e1e10},
        {angle:Math.PI*1.4,startDist:17,speed:0.014,color:0x101a0d},
    ];
    const gangsters=GANGSTER_CONFIGS.map(cfg=>{
        const mesh=makeGangster(cfg.color);
        mesh.position.set(Math.cos(cfg.angle)*cfg.startDist,0,Math.sin(cfg.angle)*cfg.startDist);
        mesh.lookAt(0,0,0); scene.add(mesh);
        return{mesh,angle:cfg.angle,startDist:cfg.startDist,currentDist:cfg.startDist,speed:cfg.speed,bouncing:false,bounceVel:0};
    });

    // Particles
    const MAX_P=600;
    const pPositions=new Float32Array(MAX_P*3).fill(9999);
    const pVelocities=Array.from({length:MAX_P},()=>new THREE.Vector3());
    const pLife=new Float32Array(MAX_P);
    const pGeo=new THREE.BufferGeometry();
    pGeo.setAttribute('position',new THREE.BufferAttribute(pPositions,3));
    const pMat=new THREE.PointsMaterial({color:0x00d4ff,size:0.18,transparent:true,opacity:0.9});
    const pMesh=new THREE.Points(pGeo,pMat);
    scene.add(pMesh);
    let pCursor=0;
    function spawnBurst(pos,color){
        pMat.color.setHex(color);
        for(let i=0;i<40;i++){
            const idx=pCursor%MAX_P;
            pPositions[idx*3]=pos.x; pPositions[idx*3+1]=pos.y+1.2; pPositions[idx*3+2]=pos.z;
            pVelocities[idx].set((Math.random()-0.5)*0.5,Math.random()*0.35,(Math.random()-0.5)*0.5);
            pLife[idx]=1.0; pCursor++;
        }
        pGeo.attributes.position.needsUpdate=true;
    }
    const ambPos=new Float32Array(300*3);
    for(let i=0;i<300;i++){ambPos[i*3]=(Math.random()-0.5)*50;ambPos[i*3+1]=Math.random()*10;ambPos[i*3+2]=(Math.random()-0.5)*50;}
    const ambGeo=new THREE.BufferGeometry();
    ambGeo.setAttribute('position',new THREE.BufferAttribute(ambPos,3));
    scene.add(new THREE.Points(ambGeo,new THREE.PointsMaterial({color:0x004466,size:0.07,transparent:true,opacity:0.55})));

    let shieldFlash=0;
    window.addEventListener('resize',()=>{
        camera.aspect=window.innerWidth/window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth,window.innerHeight);
    });

    let t=0;
    function animate(){
        requestAnimationFrame(animate);
        t+=0.016;
        camera.position.x=Math.sin(t*0.06)*7;
        camera.position.z=20+Math.cos(t*0.06)*5;
        camera.position.y=7+Math.sin(t*0.04)*1.5;
        camera.lookAt(0,2,0);
        vault.children.forEach(c=>{if(c.name==='wheel')c.rotation.z=t*0.6;});
        vault.children.forEach(c=>{if(c.name==='beacon')c.material.color.setHex(Math.sin(t*6)>0?0xff3366:0x330011);});
        keyLight.intensity=2.5+Math.sin(t*2.8)*0.7;
        shieldOuter.rotation.y=t*0.28; shieldOuter.rotation.x=t*0.11;
        shieldInner.rotation.y=-t*0.18;
        if(shieldFlash>0){
            shieldFlash=Math.max(0,shieldFlash-0.04);
            shieldOuterMat.color.setHex(shieldFlash>0.5?0xffffff:0x00d4ff);
            shieldOuterMat.opacity=0.22+shieldFlash*0.5;
            shieldInnerMat.opacity=0.04+shieldFlash*0.28;
        } else {
            shieldOuterMat.color.setHex(0x00d4ff);
            shieldOuterMat.opacity=0.18+0.07*Math.sin(t*1.8);
            shieldInnerMat.opacity=0.03+0.02*Math.sin(t*2.1);
        }
        rings.forEach((r,i)=>{ r.rotation.y=t*(0.18+i*0.04)*(i%2===0?1:-1); });
        gangsters.forEach((gd,gi)=>{
            if(gd.bouncing){
                gd.currentDist+=gd.bounceVel; gd.bounceVel*=0.90;
                if(Math.abs(gd.bounceVel)<0.004){gd.bouncing=false;gd.bounceVel=0;}
                gd.currentDist=Math.min(gd.startDist,Math.max(SHIELD_R+0.6,gd.currentDist));
            } else {
                gd.currentDist-=gd.speed;
                if(gd.currentDist<=SHIELD_R+0.5){gd.bouncing=true;gd.bounceVel=0.42;shieldFlash=1.0;spawnBurst(gd.mesh.position,gi%2===0?0xffaa00:0xff3366);}
            }
            const px=Math.cos(gd.angle)*gd.currentDist;
            const pz=Math.sin(gd.angle)*gd.currentDist;
            gd.mesh.position.set(px,Math.abs(Math.sin(t*4.5+gd.angle))*0.12,pz);
            gd.mesh.lookAt(0,gd.mesh.position.y,0);
            if(!gd.bouncing){
                const phase=Math.sin(t*6.5+gi*1.1);
                const lLeg=gd.mesh.children[6]; const rLeg=gd.mesh.children[7];
                if(lLeg)lLeg.rotation.x=phase*0.35;
                if(rLeg)rLeg.rotation.x=-phase*0.35;
            }
        });
        const pAttr=pGeo.attributes.position;
        let anyAlive=false;
        for(let i=0;i<MAX_P;i++){
            if(pLife[i]>0){
                pAttr.array[i*3]+=pVelocities[i].x; pAttr.array[i*3+1]+=pVelocities[i].y; pAttr.array[i*3+2]+=pVelocities[i].z;
                pVelocities[i].y-=0.006; pLife[i]-=0.022;
                if(pLife[i]<=0){pAttr.array[i*3]=pAttr.array[i*3+1]=pAttr.array[i*3+2]=9999;}
                anyAlive=true;
            }
        }
        if(anyAlive) pAttr.needsUpdate=true;
        renderer.render(scene,camera);
    }
    animate();
})();
</script>
