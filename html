<!-- ══════════════════════════════════════════
     JAVASCRIPT
══════════════════════════════════════════ -->
<script>
/* ═══════════════════════════════════════════════
   CONFIGURATION — change this to your backend URL
═══════════════════════════════════════════════ */
const BACKEND_URL = 'http://localhost:8000'; // ← your FastAPI server address

/* ═══════════════════════════════════════════════
   FACE-API.JS MODEL LOADING
   Models are hosted on jsDelivr CDN — no download needed
═══════════════════════════════════════════════ */
const MODEL_URL = 'https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/weights';
let faceApiReady = false;

async function loadFaceApiModels() {
    setBeacon('faceBeacon','warning','FACE-API LOADING');
    try {
        await Promise.all([
            faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
            faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
            faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL),
        ]);
        faceApiReady = true;
        setBeacon('faceBeacon','active','FACE-API READY');
        console.log('face-api.js models loaded');
    } catch(e) {
        setBeacon('faceBeacon','danger','FACE-API ERROR');
        console.error('face-api model load error:', e);
    }
}
loadFaceApiModels(); // start loading immediately on page load

/* ═══════════════════════════════════════════════
   TAB SWITCHER
═══════════════════════════════════════════════ */
function switchTab(tab) {
    document.getElementById('loginPanel').classList.toggle('active', tab==='login');
    document.getElementById('enrolPanel').classList.toggle('active', tab==='enrol');
    document.getElementById('tabLogin').classList.toggle('active', tab==='login');
    document.getElementById('tabEnrol').classList.toggle('active', tab==='enrol');
}

/* ═══════════════════════════════════════════════
   LOGIN STATE
═══════════════════════════════════════════════ */
let sessionActive = false;
let mediaStream = null;
let audioStream = null;
let camera = null;
let faceMesh = null;
let recognition = null;
let challengeCode = null;
let speechMatchResult = 'WAITING';
let lipSyncResult = 'WAITING';
let faceMatchResult = 'WAITING'; // NEW
let riskScore = 0;
let blinkCount = 0;
let blinkCooldown = false;
const EAR_THRESHOLD = 0.22;
const BLINK_CONSEC = 2;
let blinkFrameCounter = 0;
let mouthOpenCount = 0;
let mouthIsOpen = false;
const MAR_THRESHOLD = 0.04;
let lipSyncCheckDone = false;
let spokenText = '';

// Face recognition state (NEW)
let storedEmbedding = null;    // Float32Array fetched from backend
let faceCheckInterval = null;  // setInterval handle for live checking

/* ═══════════════════════════════════════════════
   UTILITIES
═══════════════════════════════════════════════ */
function dist(p1,p2){ return Math.sqrt((p1.x-p2.x)**2+(p1.y-p2.y)**2); }
function computeEAR(t1,t2,b1,b2,l,r){ return (dist(t1,b1)+dist(t2,b2))/(2*dist(l,r)); }
function computeMAR(t,b,l,r){ return dist(t,b)/(dist(l,r)+1e-6); }
function generateChallenge(){ const a=new Uint16Array(1); window.crypto.getRandomValues(a); return String(1000+(a[0]%9000)); }
function delay(ms){ return new Promise(r=>setTimeout(r,ms)); }
function addRipple(btn,e){ const rpl=document.createElement('div'); rpl.className='ripple'; const rc=btn.getBoundingClientRect(); rpl.style.left=(e.clientX-rc.left)+'px'; rpl.style.top=(e.clientY-rc.top)+'px'; btn.appendChild(rpl); setTimeout(()=>rpl.remove(),600); }
function cosineSimilarity(a,b){
    let dot=0,na=0,nb=0;
    for(let i=0;i<a.length;i++){ dot+=a[i]*b[i]; na+=a[i]*a[i]; nb+=b[i]*b[i]; }
    return dot/(Math.sqrt(na)*Math.sqrt(nb)+1e-8);
}

/* ── UI Helpers ── */
function setProcessing(show,text='PROCESSING...'){
    const row=document.getElementById('processingRow');
    document.getElementById('processingText').textContent=text;
    show?row.classList.add('show'):row.classList.remove('show');
}
function setBadge(id,label,state){
    const el=document.getElementById(id);
    el.textContent=label;
    el.className='metric-badge '+(state||'');
}
function setBeacon(id,cls,label){
    document.getElementById(id).className='beacon-dot '+cls;
    const l=document.getElementById(id+'Label');
    if(l) l.textContent=label;
}
function updateRiskUI(score){
    riskScore=Math.min(100,score);
    const bar=document.getElementById('riskBar');
    bar.style.width=riskScore+'%';
    let color,state;
    if(riskScore<30){color='var(--accent)';state='pass';}
    else if(riskScore<60){color='var(--warn)';state='warn';}
    else{color='var(--danger)';state='fail';}
    bar.style.background=color;
    setBadge('riskBadge',riskScore+' / 100',state);
    document.getElementById('riskDisplay').textContent=
        riskScore===0?'No anomalies':riskScore<30?'Low risk':riskScore<60?'Moderate risk':'High risk — possible deepfake';
}

/* ═══════════════════════════════════════════════
   NEW — STEP 1: FETCH STORED EMBEDDING FROM BACKEND
   Called at login start, before camera activates
═══════════════════════════════════════════════ */
async function fetchStoredEmbedding(userId) {
    setBadge('faceBadge','FETCHING','warn');
    document.getElementById('faceDisplay').textContent='Fetching stored face from server...';
    setFaceMatchOverlay('checking','FETCHING STORED FACE...');

    const res = await fetch(`${BACKEND_URL}/api/get-embedding/${encodeURIComponent(userId)}`);
    if(!res.ok) {
        const err = await res.json().catch(()=>({detail:'Unknown error'}));
        throw new Error(err.detail || 'User not found. Please enrol first.');
    }
    const data = await res.json();
    // data.embedding is Array(128)
    storedEmbedding = new Float32Array(data.embedding);
    setBadge('faceBadge','LOADED','info');
    document.getElementById('faceDisplay').textContent=`Stored embedding loaded (${storedEmbedding.length}-D)`;
}

/* ═══════════════════════════════════════════════
   NEW — STEP 5: LIVE FACE COMPARISON LOOP
   Runs every 1.5 seconds while session is active
═══════════════════════════════════════════════ */
async function startFaceRecognitionLoop() {
    if(!faceApiReady) {
        setBadge('faceBadge','MODEL NOT READY','fail');
        faceMatchResult='FAIL';
        return;
    }
    if(!storedEmbedding) {
        setBadge('faceBadge','NO STORED FACE','fail');
        faceMatchResult='FAIL';
        return;
    }

    setFaceMatchOverlay('checking','SCANNING...');
    setBadge('faceBadge','SCANNING','warn');

    let passCount = 0;
    let checkCount = 0;
    const REQUIRED_PASSES = 2; // must match at least 2 out of 5 checks
    const MAX_CHECKS = 5;

    return new Promise((resolve) => {
        faceCheckInterval = setInterval(async () => {
            if(!sessionActive || checkCount >= MAX_CHECKS) {
                clearInterval(faceCheckInterval);
                // Decide
                if(passCount >= REQUIRED_PASSES) {
                    faceMatchResult = 'PASS';
                    setBadge('faceBadge','✓ MATCHED','pass');
                    document.getElementById('faceDisplay').textContent=
                        `Face matched! (${passCount}/${MAX_CHECKS} checks passed)`;
                    setFaceMatchOverlay('matched','✓ FACE MATCHED');
                } else {
                    faceMatchResult = 'FAIL';
                    setBadge('faceBadge','✗ NO MATCH','fail');
                    document.getElementById('faceDisplay').textContent=
                        `Face not recognised (${passCount}/${MAX_CHECKS} checks passed)`;
                    setFaceMatchOverlay('failed','✗ FACE MISMATCH');
                }
                resolve();
                return;
            }

            checkCount++;
            const video = document.getElementById('videoEl');
            try {
                // Detect face + compute 128-D descriptor from live video frame
                const detection = await faceapi
                    .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks()
                    .withFaceDescriptor();

                if(detection) {
                    const liveEmb = detection.descriptor; // Float32Array(128)
                    const similarity = cosineSimilarity(liveEmb, storedEmbedding);
                    const pct = Math.round(similarity * 100);
                    document.getElementById('faceDisplay').textContent=
                        `Check ${checkCount}/${MAX_CHECKS} — similarity: ${pct}%`;

                    if(similarity > 0.55) passCount++; // THRESHOLD: adjust if needed
                } else {
                    document.getElementById('faceDisplay').textContent=
                        `Check ${checkCount}/${MAX_CHECKS} — no face detected, align face`;
                }
            } catch(e) {
                console.warn('face-api detect error:', e);
            }
        }, 1500);
    });
}

function setFaceMatchOverlay(cls, text) {
    const el = document.getElementById('faceMatchOverlay');
    el.className = 'face-match-overlay show ' + cls;
    el.textContent = text;
}

/* ═══════════════════════════════════════════════
   CAMERA ACTIVATION
═══════════════════════════════════════════════ */
async function activateCamera() {
    setProcessing(true,'REQUESTING CAMERA & MIC...');
    const combinedStream = await navigator.mediaDevices.getUserMedia({
        video:{width:{ideal:640},height:{ideal:480},facingMode:'user'},
        audio:true
    });
    mediaStream = new MediaStream(combinedStream.getVideoTracks());
    audioStream = new MediaStream(combinedStream.getAudioTracks());
    const video = document.getElementById('videoEl');
    video.setAttribute('playsinline',''); video.setAttribute('muted',''); video.setAttribute('autoplay','');
    video.srcObject = mediaStream;
    try { await video.play(); } catch(e){ video.muted=true; await video.play(); }
    await new Promise(resolve=>{
        if(video.videoWidth>0) return resolve();
        video.addEventListener('loadedmetadata',resolve,{once:true});
        setTimeout(resolve,2000);
    });
    document.getElementById('videoPlaceholder').style.display='none';
    document.getElementById('liveBadge').classList.add('show');
    document.getElementById('scanLine').classList.add('active');
    const canvas=document.getElementById('overlayCanvas');
    canvas.width=video.videoWidth||640; canvas.height=video.videoHeight||480;
    setBeacon('camBeacon','active','CAMERA LIVE');
    setBeacon('micBeacon','warning','MIC READY');
    setProcessing(true,'INITIATING FACE MESH...');
}

/* ═══════════════════════════════════════════════
   MEDIAPIPE FACE MESH
═══════════════════════════════════════════════ */
async function activateFaceMesh() {
    const video=document.getElementById('videoEl');
    const canvas=document.getElementById('overlayCanvas');
    const ctx=canvas.getContext('2d');
    faceMesh=new FaceMesh({locateFile:f=>`https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/${f}`});
    faceMesh.setOptions({maxNumFaces:1,refineLandmarks:true,minDetectionConfidence:0.5,minTrackingConfidence:0.5});
    faceMesh.onResults(results=>processLandmarks(results,canvas,ctx));
    const camOpts={
        onFrame:async()=>{ if(sessionActive){ canvas.width=video.videoWidth||640; canvas.height=video.videoHeight||480; await faceMesh.send({image:video}); }},
        width:video.videoWidth||640, height:video.videoHeight||480
    };
    camera=new Camera(video,camOpts);
    await camera.start();
    setProcessing(true,'FACE MESH ACTIVE');
}

function processLandmarks(results,canvas,ctx) {
    ctx.clearRect(0,0,canvas.width,canvas.height);
    if(!results.multiFaceLandmarks||!results.multiFaceLandmarks.length){
        document.getElementById('blinkDisplay').textContent='No face detected — align face';
        return;
    }
    const lm=results.multiFaceLandmarks[0];
    drawConnectors(ctx,lm,FACEMESH_TESSELATION,{color:'rgba(0,212,255,0.07)',lineWidth:0.5});
    drawConnectors(ctx,lm,FACEMESH_RIGHT_EYE,{color:'rgba(0,212,255,0.5)',lineWidth:1});
    drawConnectors(ctx,lm,FACEMESH_LEFT_EYE,{color:'rgba(0,212,255,0.5)',lineWidth:1});
    drawConnectors(ctx,lm,FACEMESH_LIPS,{color:'rgba(0,255,159,0.5)',lineWidth:1.5});

    const leftEAR=computeEAR(lm[159],lm[158],lm[145],lm[153],lm[133],lm[362]);
    const rightEAR=computeEAR(lm[386],lm[385],lm[374],lm[382],lm[362],lm[263]);
    const avgEAR=(leftEAR+rightEAR)/2;
    if(avgEAR<EAR_THRESHOLD){ blinkFrameCounter++; }
    else {
        if(blinkFrameCounter>=BLINK_CONSEC&&!blinkCooldown){
            blinkCount++;
            blinkCooldown=true;
            setBadge('blinkBadge',String(blinkCount),'info');
            document.getElementById('blinkDisplay').textContent=`${blinkCount} blink${blinkCount!==1?'s':''} detected (EAR: ${avgEAR.toFixed(3)})`;
            setTimeout(()=>{blinkCooldown=false;},400);
        }
        blinkFrameCounter=0;
    }
    const mar=computeMAR(lm[13],lm[14],lm[61],lm[291]);
    if(mar>MAR_THRESHOLD&&!mouthIsOpen){ mouthIsOpen=true; }
    else if(mar<=MAR_THRESHOLD&&mouthIsOpen){ mouthIsOpen=false; mouthOpenCount++; }
    if(!lipSyncCheckDone){
        document.getElementById('lipSyncDisplay').textContent=`Mouth cycles: ${mouthOpenCount} | MAR: ${mar.toFixed(3)}`;
    }
}

/* ═══════════════════════════════════════════════
   SPEECH RECOGNITION
═══════════════════════════════════════════════ */
function activateSpeech() {
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR){ document.getElementById('speechDisplay').textContent='Speech API not supported'; setBadge('speechBadge','UNSUPPORTED','fail'); speechMatchResult='FAIL'; evaluateLipSync(); return; }
    recognition=new SR();
    recognition.lang='en-IN'; recognition.continuous=false; recognition.interimResults=true; recognition.maxAlternatives=3;
    setBeacon('micBeacon','active','MIC LIVE');
    setProcessing(true,'LISTENING — SPEAK THE NUMBER NOW');
    recognition.onstart=()=>{ document.getElementById('speechDisplay').textContent='...listening...'; };
    recognition.onresult=(event)=>{
        let interim='',finalText='';
        for(let i=event.resultIndex;i<event.results.length;i++){
            const t=event.results[i][0].transcript;
            if(event.results[i].isFinal) finalText+=t; else interim+=t;
        }
        spokenText=finalText||interim;
        document.getElementById('speechDisplay').textContent=`"${spokenText}"`;
    };
    recognition.onerror=(e)=>{ document.getElementById('speechDisplay').textContent=`Error: ${e.error}`; setBadge('speechBadge','ERROR','fail'); speechMatchResult='FAIL'; evaluateLipSync(); };
    recognition.onend=()=>{ setBeacon('micBeacon','idle','MIC IDLE'); evaluateSpeech(); };
    recognition.start();
    setTimeout(()=>{ if(recognition&&sessionActive){ try{recognition.stop();}catch(_){} } },10000);
}

function wordToDigits(text) {
    const map={zero:0,one:1,two:2,three:3,four:4,five:5,six:6,seven:7,eight:8,nine:9};
    return text.toLowerCase().replace(/\b(zero|one|two|three|four|five|six|seven|eight|nine)\b/g,m=>map[m]);
}
function evaluateSpeech() {
    if(!sessionActive) return;
    const cleaned=wordToDigits(spokenText);
    const extracted=cleaned.replace(/\D/g,'');
    document.getElementById('speechDisplay').textContent=`"${spokenText}" → parsed: ${extracted||'(none)'}`;
    if(extracted===challengeCode){ speechMatchResult='PASS'; setBadge('speechBadge','✓ PASS','pass'); }
    else { speechMatchResult='FAIL'; setBadge('speechBadge','✗ FAIL','fail'); }
    evaluateLipSync();
}
function evaluateLipSync() {
    if(!sessionActive) return;
    lipSyncCheckDone=true;
    const digits=challengeCode.length;
    const minCycles=Math.max(1,digits-2);
    const maxCycles=digits+4;
    const ok=mouthOpenCount>=minCycles&&mouthOpenCount<=maxCycles;
    if(ok){ lipSyncResult='PASS'; setBadge('lipSyncBadge','✓ PASS','pass'); document.getElementById('lipSyncDisplay').textContent=`${mouthOpenCount} cycles (expected ${minCycles}–${maxCycles}) ✓`; }
    else { lipSyncResult='FAIL'; setBadge('lipSyncBadge','✗ FAIL','fail'); document.getElementById('lipSyncDisplay').textContent=`${mouthOpenCount} cycles (expected ${minCycles}–${maxCycles}) ✗`; }
    finalizeResults();
}

/* ═══════════════════════════════════════════════
   RISK SCORE — now includes faceMatchResult
═══════════════════════════════════════════════ */
function computeRiskScore() {
    let score=0;
    if(faceMatchResult!=='PASS') score+=40;  // face mismatch = biggest red flag
    if(blinkCount<2) score+=20;
    if(lipSyncResult==='FAIL') score+=20;
    if(speechMatchResult==='FAIL') score+=20;
    return Math.min(score,100);
}

/* ═══════════════════════════════════════════════
   FINAL DECISION — now requires faceMatchResult=PASS
═══════════════════════════════════════════════ */
function finalizeResults() {
    if(!sessionActive) return;
    setProcessing(false);
    const finalScore=computeRiskScore();
    updateRiskUI(finalScore);
    const banner=document.getElementById('resultBanner');
    const icon=document.getElementById('resultIcon');
    const title=document.getElementById('resultTitle');
    const subtitle=document.getElementById('resultSubtitle');

    // ALL THREE must pass: face recognition + speech + lipsync
    const authenticated=
        faceMatchResult==='PASS' &&
        speechMatchResult==='PASS' &&
        lipSyncResult==='PASS' &&
        finalScore<50;

    if(authenticated){
        banner.className='result-banner success';
        icon.textContent='✅';
        title.textContent='Authentication Successful';
        subtitle.textContent=`IDENTITY VERIFIED — Face ✓ Speech ✓ Liveness ✓ — Risk: ${finalScore}/100`;
    } else {
        banner.className='result-banner failure';
        icon.textContent='🚨';
        title.textContent='Authentication Failed';
        let reasons=[];
        if(faceMatchResult!=='PASS') reasons.push('Face mismatch');
        if(speechMatchResult!=='PASS') reasons.push('Speech mismatch');
        if(lipSyncResult!=='PASS') reasons.push('Lip sync failure');
        if(finalScore>=50) reasons.push(`Risk ${finalScore}/100`);
        subtitle.textContent=reasons.join(' | ')||'Unknown anomaly';
    }
    stopFaceMesh();
    document.getElementById('resetBtn').disabled=false;
    document.getElementById('loginBtn').disabled=true;
}

/* ═══════════════════════════════════════════════
   MAIN LOGIN FLOW — modified to add face recognition
═══════════════════════════════════════════════ */
async function startLogin(event) {
    if(sessionActive) return;

    const userId = document.getElementById('loginUserId').value.trim();
    if(!userId) { alert('Please enter your User ID first.'); return; }

    sessionActive=true;
    addRipple(event.currentTarget,event);
    document.getElementById('loginBtn').disabled=true;
    document.getElementById('resetBtn').disabled=false;

    try {
        // Step 1: Fetch stored embedding from backend (NEW)
        await fetchStoredEmbedding(userId);

        // Step 2: Activate camera
        await activateCamera();

        // Step 3: Show challenge
        challengeCode=generateChallenge();
        const el=document.getElementById('challengeNumber');
        el.textContent=challengeCode; el.classList.add('show');
        document.getElementById('challengeHint').textContent='Say this number clearly into your microphone';

        // Step 4: Start face mesh for blink/lip detection
        await activateFaceMesh();

        // Step 5: Start face recognition loop (NEW — runs in parallel)
        setProcessing(true,'FACE RECOGNITION SCANNING...');
        const facePromise = startFaceRecognitionLoop(); // runs 5 checks over ~7.5s

        // Step 6: Wait 2s then start speech
        await delay(2000);
        activateSpeech(); // this is async but doesn't return a promise we need to await

        // Step 7: Wait for face recognition to finish
        await facePromise;
        setProcessing(false);

    } catch(err) {
        console.error('Login error:',err);
        setProcessing(false);
        alert('Error: '+err.message);
        resetSystem({currentTarget:document.getElementById('resetBtn'),clientX:0,clientY:0});
    }
}

