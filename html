<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nidhi Rakshak — Face Auth v3</title>

    <!-- Three.js -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.152.2/build/three.min.js"></script>
    <!-- MediaPipe Face Mesh -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>
    <!-- face-api.js — for 128-D face embedding extraction -->
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;900&family=Share+Tech+Mono&family=Rajdhani:wght@400;600&display=swap');

        *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }

        :root {
            --bg-deep:#010a14; --bg-card:rgba(4,20,40,0.95);
            --primary:#00d4ff; --primary-dim:rgba(0,212,255,0.15);
            --accent:#00ff9f; --danger:#ff3366; --warn:#ffb300;
            --text-main:#c9eeff; --text-muted:#4a7a99;
            --border:rgba(0,212,255,0.25);
            --glow-primary:0 0 12px rgba(0,212,255,0.6),0 0 30px rgba(0,212,255,0.2);
            --glow-accent:0 0 12px rgba(0,255,159,0.6),0 0 30px rgba(0,255,159,0.2);
            --glow-danger:0 0 12px rgba(255,51,102,0.6),0 0 30px rgba(255,51,102,0.2);
        }
        html { scroll-behavior:smooth; }
        body {
            font-family:'Rajdhani',sans-serif;
            background:var(--bg-deep); color:var(--text-main);
            min-height:100vh; display:flex; flex-direction:column;
            align-items:center; padding:24px 16px 48px; overflow-x:hidden;
        }
        body::before {
            content:''; position:fixed; inset:0;
            background:linear-gradient(rgba(0,212,255,0.03) 1px,transparent 1px),
                        linear-gradient(90deg,rgba(0,212,255,0.03) 1px,transparent 1px);
            background-size:40px 40px; pointer-events:none; z-index:5;
            animation:gridPan 20s linear infinite;
        }
        body::after {
            content:''; position:fixed; inset:0;
            background:repeating-linear-gradient(0deg,rgba(0,0,0,0.08) 0px,rgba(0,0,0,0.08) 1px,transparent 1px,transparent 3px);
            pointer-events:none; z-index:6;
        }
        @keyframes gridPan { 100% { background-position:40px 40px,40px 40px; } }

        /* ── HEADER ── */
        .app-header { position:relative; z-index:10; text-align:center; margin-bottom:24px; }
        .logo-line { display:flex; align-items:center; justify-content:center; gap:16px; margin-bottom:6px; }
        .logo-icon {
            width:52px; height:52px; border:2px solid var(--primary); border-radius:50%;
            display:flex; align-items:center; justify-content:center; font-size:24px;
            box-shadow:var(--glow-primary); animation:pulse-ring 2.5s ease-in-out infinite;
        }
        @keyframes pulse-ring {
            0%,100% { box-shadow:var(--glow-primary); }
            50% { box-shadow:0 0 25px rgba(0,212,255,0.9),0 0 60px rgba(0,212,255,0.4); }
        }
        .app-title {
            font-family:'Orbitron',sans-serif; font-size:clamp(1.4rem,4vw,2.4rem);
            font-weight:900; letter-spacing:3px;
            background:linear-gradient(135deg,var(--primary) 0%,var(--accent) 100%);
            -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
        }
        .app-subtitle { font-family:'Share Tech Mono',monospace; font-size:0.75rem; color:var(--text-muted); letter-spacing:4px; text-transform:uppercase; }
        .beacon-row { display:flex; gap:20px; justify-content:center; margin-top:10px; flex-wrap:wrap; }
        .beacon { display:flex; align-items:center; gap:6px; font-family:'Share Tech Mono',monospace; font-size:0.65rem; letter-spacing:1px; color:var(--text-muted); }
        .beacon-dot { width:8px; height:8px; border-radius:50%; background:var(--text-muted); }
        .beacon-dot.active { background:var(--accent); box-shadow:var(--glow-accent); animation:blink 1.2s ease-in-out infinite; }
        .beacon-dot.warning { background:var(--warn); box-shadow:0 0 8px rgba(255,179,0,0.7); animation:blink 0.8s ease-in-out infinite; }
        .beacon-dot.danger { background:var(--danger); box-shadow:var(--glow-danger); }
        .beacon-dot.idle { background:var(--text-muted); }
        @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

        /* ── TAB SWITCHER (NEW — Login vs Enrol) ── */
        .tab-bar {
            position:relative; z-index:10;
            display:flex; gap:0; margin-bottom:20px;
            border:1px solid var(--border); border-radius:8px; overflow:hidden;
        }
        .tab-btn {
            flex:1; padding:10px 28px;
            font-family:'Orbitron',sans-serif; font-size:0.7rem; letter-spacing:2px;
            background:transparent; color:var(--text-muted);
            border:none; cursor:pointer; transition:all 0.25s ease;
        }
        .tab-btn.active {
            background:var(--primary-dim); color:var(--primary);
            box-shadow:inset 0 0 20px rgba(0,212,255,0.1);
        }
        .tab-btn:hover:not(.active) { background:rgba(0,212,255,0.05); color:var(--text-main); }

        /* ── MAIN CARD ── */
        .card {
            position:relative; z-index:10; width:100%; max-width:960px;
            background:var(--bg-card); border:1px solid var(--border);
            border-radius:16px; padding:32px;
            box-shadow:0 0 0 1px rgba(0,212,255,0.08),0 20px 60px rgba(0,0,0,0.7),inset 0 1px 0 rgba(255,255,255,0.04);
            backdrop-filter:blur(12px); overflow:hidden;
        }
        .card::before,.card::after { content:''; position:absolute; width:24px; height:24px; border-color:var(--primary); border-style:solid; }
        .card::before { top:12px; left:12px; border-width:2px 0 0 2px; border-radius:4px 0 0 0; }
        .card::after { bottom:12px; right:12px; border-width:0 2px 2px 0; border-radius:0 0 4px 0; }

        /* mode panels */
        .mode-panel { display:none; }
        .mode-panel.active { display:block; }

        /* ── TWO-COLUMN LAYOUT ── */
        .main-layout { display:grid; grid-template-columns:1fr 1fr; gap:28px; }
        @media(max-width:640px) { .main-layout { grid-template-columns:1fr; } }

        /* ── VIDEO PANEL ── */
        .video-panel { display:flex; flex-direction:column; gap:16px; }
        .video-wrapper {
            position:relative; width:100%; aspect-ratio:4/3;
            background:#000; border:1px solid var(--border); border-radius:10px; overflow:hidden;
        }
        #videoEl,#enrollVideoEl { width:100%; height:100%; object-fit:cover; display:block; transform:scaleX(-1); }
        #overlayCanvas,#enrollCanvas {
            position:absolute; inset:0; width:100%; height:100%;
            pointer-events:none; transform:scaleX(-1);
        }
        .video-placeholder {
            position:absolute; inset:0; display:flex; flex-direction:column;
            align-items:center; justify-content:center; gap:10px;
            color:var(--text-muted); font-family:'Share Tech Mono',monospace; font-size:0.8rem;
        }
        .video-placeholder .cam-icon { font-size:3rem; opacity:0.4; }
        .frame-tl,.frame-br { position:absolute; width:28px; height:28px; border-color:var(--primary); border-style:solid; opacity:0.7; }
        .frame-tl { top:10px; left:10px; border-width:2px 0 0 2px; border-radius:2px; }
        .frame-br { bottom:10px; right:10px; border-width:0 2px 2px 0; border-radius:2px; }
        .scan-line {
            position:absolute; left:0; right:0; height:2px;
            background:linear-gradient(90deg,transparent,var(--primary),transparent);
            opacity:0; box-shadow:0 0 8px var(--primary);
        }
        .scan-line.active { opacity:0.8; animation:scanDown 2.5s ease-in-out infinite; }
        @keyframes scanDown { 0%{top:0%;opacity:0} 10%{opacity:0.8} 90%{opacity:0.8} 100%{top:100%;opacity:0} }
        .live-badge {
            position:absolute; top:10px; right:10px;
            background:rgba(255,51,102,0.2); border:1px solid var(--danger);
            border-radius:4px; padding:2px 8px;
            font-family:'Orbitron',sans-serif; font-size:0.6rem; letter-spacing:2px;
            color:var(--danger); display:none;
        }
        .live-badge.show { display:block; animation:blink 1s ease-in-out infinite; }

        /* ── FACE MATCH STATUS BADGE (NEW) ── */
        .face-match-overlay {
            position:absolute; bottom:10px; left:10px;
            background:rgba(0,20,40,0.85); border-radius:6px;
            padding:4px 10px; font-family:'Share Tech Mono',monospace; font-size:0.65rem;
            letter-spacing:1px; display:none; transition:all 0.3s;
        }
        .face-match-overlay.show { display:block; }
        .face-match-overlay.checking { color:var(--warn); border:1px solid var(--warn); }
        .face-match-overlay.matched { color:var(--accent); border:1px solid var(--accent); }
        .face-match-overlay.failed { color:var(--danger); border:1px solid var(--danger); }

        /* ── CHALLENGE BOX ── */
        .challenge-box { background:rgba(0,212,255,0.04); border:1px solid var(--border); border-radius:10px; padding:16px; text-align:center; }
        .challenge-label { font-family:'Share Tech Mono',monospace; font-size:0.65rem; letter-spacing:3px; color:var(--text-muted); margin-bottom:8px; text-transform:uppercase; }
        .challenge-number { font-family:'Orbitron',sans-serif; font-size:3rem; font-weight:900; letter-spacing:12px; color:var(--warn); text-shadow:0 0 20px rgba(255,179,0,0.6); display:none; }
        .challenge-number.show { display:block; animation:flicker 0.12s ease-in 0.3s; }
        @keyframes flicker { 0%,100%{opacity:1} 50%{opacity:0.5} }
        .challenge-hint { font-size:0.75rem; color:var(--text-muted); margin-top:6px; }

        /* ── STATUS PANEL ── */
        .status-panel { display:flex; flex-direction:column; gap:14px; }
        .section-label { font-family:'Share Tech Mono',monospace; font-size:0.6rem; letter-spacing:4px; color:var(--text-muted); text-transform:uppercase; margin-bottom:2px; }
        .metric-row { background:rgba(0,212,255,0.035); border:1px solid var(--border); border-radius:8px; padding:12px 14px; }
        .metric-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }
        .metric-title { font-family:'Orbitron',sans-serif; font-size:0.65rem; letter-spacing:1px; color:var(--text-muted); text-transform:uppercase; }
        .metric-badge { font-family:'Share Tech Mono',monospace; font-size:0.7rem; padding:2px 10px; border-radius:3px; border:1px solid transparent; background:rgba(74,122,153,0.2); color:var(--text-muted); transition:all 0.3s ease; }
        .metric-badge.pass { background:rgba(0,255,159,0.15); border-color:var(--accent); color:var(--accent); box-shadow:var(--glow-accent); }
        .metric-badge.fail { background:rgba(255,51,102,0.15); border-color:var(--danger); color:var(--danger); box-shadow:var(--glow-danger); }
        .metric-badge.warn { background:rgba(255,179,0,0.15); border-color:var(--warn); color:var(--warn); }
        .metric-badge.info { background:rgba(0,212,255,0.15); border-color:var(--primary); color:var(--primary); }
        .metric-value { font-family:'Share Tech Mono',monospace; font-size:0.95rem; color:var(--text-main); min-height:1.2em; word-break:break-word; }
        .risk-bar-container { margin-top:6px; height:6px; background:rgba(255,255,255,0.06); border-radius:3px; overflow:hidden; }
        #riskBar { height:100%; width:0%; border-radius:3px; background:var(--accent); transition:width 0.5s ease,background 0.5s ease; }

        /* ── RESULT BANNER ── */
        .result-banner { display:none; margin-top:24px; padding:22px; border-radius:12px; text-align:center; animation:fadeSlideIn 0.5s ease; }
        .result-banner.success { display:block; background:rgba(0,255,159,0.08); border:2px solid var(--accent); box-shadow:var(--glow-accent),inset 0 0 40px rgba(0,255,159,0.04); }
        .result-banner.failure { display:block; background:rgba(255,51,102,0.08); border:2px solid var(--danger); box-shadow:var(--glow-danger),inset 0 0 40px rgba(255,51,102,0.04); }
        @keyframes fadeSlideIn { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
        .result-icon { font-size:3rem; margin-bottom:8px; }
        .result-title { font-family:'Orbitron',sans-serif; font-size:clamp(1rem,3vw,1.6rem); font-weight:900; letter-spacing:3px; margin-bottom:6px; }
        .result-banner.success .result-title { color:var(--accent); text-shadow:var(--glow-accent); }
        .result-banner.failure .result-title { color:var(--danger); text-shadow:var(--glow-danger); }
        .result-subtitle { font-family:'Share Tech Mono',monospace; font-size:0.75rem; color:var(--text-muted); letter-spacing:2px; }

        /* ── BUTTONS ── */
        .btn-row { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; margin-top:24px; }
        .btn {
            position:relative; font-family:'Orbitron',sans-serif; font-size:0.75rem;
            font-weight:600; letter-spacing:2px; text-transform:uppercase;
            padding:14px 36px; border:none; border-radius:6px; cursor:pointer;
            overflow:hidden; transition:transform 0.15s ease,box-shadow 0.3s ease;
        }
        .btn:active { transform:scale(0.96); }
        .btn-primary { background:linear-gradient(135deg,#0099cc 0%,#00d4ff 100%); color:#000a14; box-shadow:0 0 18px rgba(0,212,255,0.4),0 4px 14px rgba(0,0,0,0.4); }
        .btn-primary:hover { box-shadow:0 0 28px rgba(0,212,255,0.7),0 6px 20px rgba(0,0,0,0.4); }
        .btn-accent { background:linear-gradient(135deg,#007744 0%,#00ff9f 100%); color:#001a0a; box-shadow:0 0 18px rgba(0,255,159,0.4),0 4px 14px rgba(0,0,0,0.4); }
        .btn-accent:hover { box-shadow:0 0 28px rgba(0,255,159,0.7),0 6px 20px rgba(0,0,0,0.4); }
        .btn-reset { background:rgba(255,51,102,0.12); border:1px solid var(--danger); color:var(--danger); box-shadow:0 0 10px rgba(255,51,102,0.2); }
        .btn-reset:hover { background:rgba(255,51,102,0.2); box-shadow:var(--glow-danger); }
        .btn:disabled { opacity:0.4; cursor:not-allowed; transform:none !important; }
        .btn .ripple { position:absolute; width:0; height:0; border-radius:50%; background:rgba(255,255,255,0.2); transform:translate(-50%,-50%); animation:rippleAnim 0.5s ease-out; pointer-events:none; }
        @keyframes rippleAnim { to { width:200px; height:200px; opacity:0; } }

        /* ── LOADER ── */
        .loader { display:none; width:20px; height:20px; border:2px solid rgba(0,212,255,0.15); border-top-color:var(--primary); border-radius:50%; animation:spin 0.8s linear infinite; margin:auto; }
        .loader.show { display:block; }
        @keyframes spin { to { transform:rotate(360deg); } }
        .processing-row { display:none; align-items:center; justify-content:center; gap:10px; margin-top:14px; font-family:'Share Tech Mono',monospace; font-size:0.7rem; color:var(--primary); letter-spacing:2px; }
        .processing-row.show { display:flex; }

        /* ── ENROLMENT PANEL (NEW) ── */
        .enrol-layout { display:grid; grid-template-columns:1fr 1fr; gap:28px; }
        @media(max-width:640px) { .enrol-layout { grid-template-columns:1fr; } }
        .enrol-steps { display:flex; flex-direction:column; gap:12px; }
        .enrol-step {
            display:flex; align-items:flex-start; gap:12px;
            padding:12px 14px; border-radius:8px;
            border:1px solid var(--border); background:rgba(0,212,255,0.03);
            transition:all 0.3s;
        }
        .enrol-step.active { border-color:var(--primary); background:var(--primary-dim); }
        .enrol-step.done { border-color:var(--accent); background:rgba(0,255,159,0.06); }
        .enrol-step.error { border-color:var(--danger); background:rgba(255,51,102,0.06); }
        .step-num { font-family:'Orbitron',sans-serif; font-size:0.75rem; font-weight:900; width:24px; flex-shrink:0; padding-top:2px; color:var(--text-muted); }
        .enrol-step.active .step-num { color:var(--primary); }
        .enrol-step.done .step-num { color:var(--accent); }
        .enrol-step.error .step-num { color:var(--danger); }
        .step-content { flex:1; }
        .step-title { font-family:'Orbitron',sans-serif; font-size:0.65rem; letter-spacing:1px; margin-bottom:3px; }
        .step-desc { font-family:'Share Tech Mono',monospace; font-size:0.7rem; color:var(--text-muted); line-height:1.5; }
        .user-id-input {
            width:100%; margin-top:8px;
            background:rgba(0,212,255,0.05); border:1px solid var(--border);
            border-radius:6px; padding:8px 12px;
            font-family:'Share Tech Mono',monospace; font-size:0.85rem;
            color:var(--text-main); outline:none; letter-spacing:2px;
        }
        .user-id-input:focus { border-color:var(--primary); box-shadow:0 0 8px rgba(0,212,255,0.3); }
        .capture-progress {
            margin-top:8px; height:4px; background:rgba(255,255,255,0.06);
            border-radius:2px; overflow:hidden;
        }
        .capture-fill { height:100%; width:0%; background:var(--accent); transition:width 0.4s ease; border-radius:2px; }
        .capture-count { font-family:'Share Tech Mono',monospace; font-size:0.7rem; color:var(--text-muted); margin-top:4px; }

        /* ── FOOTER ── */
        .app-footer { position:relative; z-index:10; margin-top:28px; font-family:'Share Tech Mono',monospace; font-size:0.6rem; color:var(--text-muted); letter-spacing:2px; text-align:center; opacity:0.6; }

        /* ── INFO BOX ── */
        .info-box {
            background:rgba(0,212,255,0.05); border:1px solid rgba(0,212,255,0.2);
            border-radius:8px; padding:12px 16px; margin-bottom:16px;
            font-family:'Share Tech Mono',monospace; font-size:0.7rem; color:var(--text-muted);
            line-height:1.7; letter-spacing:0.5px;
        }
        .info-box span { color:var(--primary); }
    </style>
</head>
<body>

<canvas id="bgCanvas" style="position:fixed;top:0;left:0;width:100%;height:100%;z-index:2;pointer-events:none;"></canvas>

<!-- HEADER -->
<header class="app-header">
    <div class="logo-line">
        <div class="logo-icon">🛡️</div>
        <h1 class="app-title">Nidhi Rakshak</h1>
    </div>
    <p class="app-subtitle">Authentication System v3 — Face Recognition + Deepfake Defence</p>
    <div class="beacon-row">
        <div class="beacon"><div class="beacon-dot active" id="sysBeacon"></div><span id="sysBeaconLabel">SYSTEM ONLINE</span></div>
        <div class="beacon"><div class="beacon-dot idle" id="camBeacon"></div><span id="camBeaconLabel">CAMERA IDLE</span></div>
        <div class="beacon"><div class="beacon-dot idle" id="micBeacon"></div><span id="micBeaconLabel">MIC IDLE</span></div>
        <div class="beacon"><div class="beacon-dot idle" id="faceBeacon"></div><span id="faceBeaconLabel">FACE-API LOADING</span></div>
    </div>
</header>

<!-- TAB BAR -->
<div class="tab-bar">
    <button class="tab-btn active" id="tabLogin" onclick="switchTab('login')">🔐 LOGIN</button>
    <button class="tab-btn" id="tabEnrol" onclick="switchTab('enrol')">👤 ENROL NEW USER</button>
</div>

<!-- MAIN CARD -->
<main class="card">

    <!-- ══════════════ LOGIN PANEL ══════════════ -->
    <div class="mode-panel active" id="loginPanel">

        <!-- User ID input row -->
        <div class="info-box" style="margin-bottom:16px">
            Enter your <span>User ID</span> before clicking Login. The system will fetch your stored face from the backend, then compare it with your live webcam feed.
        </div>
        <div style="display:flex;gap:10px;align-items:center;margin-bottom:20px">
            <label style="font-family:'Share Tech Mono',monospace;font-size:0.7rem;letter-spacing:2px;color:var(--text-muted);white-space:nowrap">USER ID :</label>
            <input class="user-id-input" id="loginUserId" placeholder="e.g. user_001" style="flex:1" />
        </div>

        <div class="main-layout">
            <!-- LEFT: VIDEO -->
            <div class="video-panel">
                <div class="video-wrapper" id="videoWrapper">
                    <video id="videoEl" autoplay muted playsinline></video>
                    <canvas id="overlayCanvas"></canvas>
                    <div class="video-placeholder" id="videoPlaceholder">
                        <div class="cam-icon">📷</div>
                        <div>CAMERA OFFLINE</div>
                        <div style="font-size:0.6rem;letter-spacing:3px">PRESS LOGIN TO ACTIVATE</div>
                    </div>
                    <div class="frame-tl"></div>
                    <div class="frame-br"></div>
                    <div class="scan-line" id="scanLine"></div>
                    <div class="live-badge" id="liveBadge">● LIVE</div>
                    <!-- NEW: face match status badge -->
                    <div class="face-match-overlay" id="faceMatchOverlay">SCANNING FACE...</div>
                </div>

                <!-- Challenge Number -->
                <div class="challenge-box">
                    <div class="challenge-label">🔢 Speak this number aloud</div>
                    <div class="challenge-number" id="challengeNumber">----</div>
                    <div class="challenge-hint" id="challengeHint">Challenge will appear after login</div>
                </div>

                <div class="processing-row" id="processingRow">
                    <div class="loader show"></div>
                    <span id="processingText">INITIALISING...</span>
                </div>
            </div>

            <!-- RIGHT: STATUS -->
            <div class="status-panel">
                <div class="section-label">⬡ Biometric Analysis</div>

                <!-- NEW: Face Recognition row -->
                <div class="metric-row">
                    <div class="metric-header">
                        <span class="metric-title">🧬 Face Recognition</span>
                        <span class="metric-badge" id="faceBadge">WAITING</span>
                    </div>
                    <div class="metric-value" id="faceDisplay">—</div>
                </div>

                <!-- Speech -->
                <div class="metric-row">
                    <div class="metric-header">
                        <span class="metric-title">🎙 Speech Match</span>
                        <span class="metric-badge" id="speechBadge">WAITING</span>
                    </div>
                    <div class="metric-value" id="speechDisplay">—</div>
                </div>

                <!-- Lip Sync -->
